# Kopieren nach .env und ausfüllen:  cp .env.example .env
#
# Den Wert findest du in ~/.hermes/.env. Bewusst NICHT automatisch von dort
# gelesen: das ist der Hermes-Credential-Store, die App fasst ihn nicht an.
OPENROUTER_API_KEY=sk-or-v1-...

# --- Optional, sinnvolle Defaults sind im Code gesetzt ---

# STT: "small" (Default, ~1.5s für 7s Audio) oder "medium" (~4s, hier nicht genauer)
# WHISPER_MODEL=small

# TTS-Stimme (Fish Audio Voice-ID). Default: "Brian British".
# Alternativen aus dem Test, siehe README:
#   30c0f62e3e6d45d88387d1b8f84e1685  Liam - Calm British Voice
#   72324f5951924b2eb27faaf5630153b4  David - British Storyteller
# TTS_VOICE=65c0b8155c464a648161af8877404f11
# Kostenloses Modell (verifiziert 2026-09-20). Achtung: "fish-audio/s2.1-pro-free"
# OHNE ":free"-Suffix liefert 404 — der Doppelpunkt ist zwingend.
# TTS_MODEL=fish-audio/s2.1-pro-free:free

# Name der Hermes-Session, die fortgeführt wird
# HERMES_SESSION=jarvis-voice
# Sekunden, die Hermes für eine Antwort bekommen darf
# HERMES_TIMEOUT=300
